<%= turbo_frame_tag "modal" do %>
  <div class="fixed inset-0 flex items-center justify-center bg-black bg-opacity-50 z-50 transition-opacity duration-300 opacity-0 pointer-events-none" data-controller="modal" data-modal-target="modal" data-action="click->modal#closeWithBackdrop">
    <div class="w-[calc(100%-1.5rem)] max-w-lg max-h-[90dvh] flex flex-col bg-white rounded-lg overflow-hidden shadow-xl transform transition-all sm:max-w-lg sm:w-full" data-modal-target="dialog" data-action="click->modal#stopPropagation">
      <div class="bg-stone-800 px-4 py-3 sm:px-6 flex justify-between items-center shrink-0">
        <h5 class="text-lg leading-6 font-medium text-white"><%= title %></h5>
        <button type="button" class="text-white inline-flex items-center justify-center min-h-[44px] min-w-[44px] sm:min-h-[auto] sm:min-w-[auto]" data-action="modal#close" aria-label="Close">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
      <div class="px-4 py-5 sm:p-6 flex-1 min-h-0 overflow-y-auto overscroll-contain" id="modal_body">
        <%= yield %>
      </div>
    </div>
  </div>
<% end %>
